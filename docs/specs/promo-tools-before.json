[
 {
  "name": "yandex_metrica_list_counters",
  "inputSchema": {
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
    "page": {
     "description": "Page number (1-based)",
     "type": "integer",
     "minimum": 1,
     "maximum": 9007199254740991
    },
    "per_page": {
     "description": "Items per page (max 1000)",
     "type": "integer",
     "minimum": 1,
     "maximum": 1000
    },
    "status": {
     "description": "Filter by counter status",
     "type": "string",
     "enum": [
      "Active",
      "Deleted"
     ]
    },
    "type": {
     "description": "Filter by counter type",
     "type": "string",
     "enum": [
      "simple",
      "partner"
     ]
    },
    "search": {
     "description": "Search by counter name or site URL",
     "type": "string"
    },
    "sort": {
     "description": "Sort order",
     "type": "string",
     "enum": [
      "Default",
      "Id",
      "Name",
      "Site",
      "Hits"
     ]
    }
   }
  }
 },
