     "items": {
      "type": "string",
      "minLength": 1
     },
     "description": "Fields to export. See Yandex Metrica Logs API documentation for full field lists."
    },
    "attribution": {
     "description": "Attribution model for traffic source fields. Default: lastsign.",
     "type": "string",
     "enum": [
      "first",
      "last",
      "lastsign",
      "last_yandex_direct_click",
      "cross_device_first",
      "cross_device_last",
      "cross_device_last_significant",
      "cross_device_last_yandex_direct_click",
      "automatic"
     ]
    }
   },
   "required": [
    "counter_id",
    "date1",
    "date2",
    "source",
    "fields"
   ]
  }
 },
